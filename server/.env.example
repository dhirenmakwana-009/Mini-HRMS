NODE_ENV=production
PORT=3000

# Exact deployed Vercel frontend URL, without a trailing slash
CLIENT_ORIGIN=https://your-frontend.vercel.app

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mini-hrms
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m

# Required because Vercel and Render use different domains
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

SEED_ORGANIZATION_NAME=DM WebSoft
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin@123
